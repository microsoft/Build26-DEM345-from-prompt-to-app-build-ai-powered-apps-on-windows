<UserControl
    x:Class="VideoStudio.Controls.HardwareUsageBars"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Padding="0">

    <!-- Compact horizontal chip strip — one pill per device.
         The "primary" device for the step's engine is highlighted (filled background).
         Hidden entirely when no device has any activity (gated from code-behind). -->
    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

        <!-- NPU chip (primary for WindowsML/WindowsAI steps) -->
        <Border x:Name="NpuChip"
                CornerRadius="10"
                Padding="8,3"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentTealBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="NPU" FontSize="10" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="NpuValueText" Text="{x:Bind NpuPercent, Mode=OneTime}"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- CPU chip (primary for LinuxContainer steps) -->
        <Border x:Name="CpuChip"
                CornerRadius="10"
                Padding="8,3"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{StaticResource ContainerBadgeBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="CPU" FontSize="10" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="CpuValueText" Text="{x:Bind CpuPercent, Mode=OneTime}"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- GPU chip — usually quiet, kept as small subdued chip -->
        <Border x:Name="GpuChip"
                CornerRadius="10"
                Padding="8,3"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="#7C3AED" VerticalAlignment="Center"/>
                <TextBlock Text="GPU" FontSize="10" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="GpuValueText" Text="{x:Bind GpuPercent, Mode=OneTime}"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- RAM chip — quiet but informative -->
        <Border x:Name="RamChip"
                CornerRadius="10"
                Padding="8,3"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="RAM" FontSize="10" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="RamValueText" Text="{x:Bind MemoryPercent, Mode=OneTime}"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
