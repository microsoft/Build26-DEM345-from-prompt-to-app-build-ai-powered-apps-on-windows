<UserControl
    x:Class="VideoStudio.Controls.HardwareUsageBars"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Padding="8">

    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*"
          RowSpacing="6" ColumnSpacing="16">

        <!-- CPU -->
        <StackPanel Grid.Row="0" Grid.Column="0"
                    Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center">
            <TextBlock Text="CPU" Width="32" FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <ProgressBar Value="{x:Bind CpuValue, Mode=OneWay}"
                         Minimum="0" Maximum="100"
                         MinWidth="80" Height="4"
                         CornerRadius="2"
                         Foreground="{ThemeResource AccentTealBrush}"
                         VerticalAlignment="Center"/>
            <TextBlock Text="{x:Bind CpuPercent, Mode=OneWay}"
                       Width="32" FontSize="11"
                       TextAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- GPU -->
        <StackPanel Grid.Row="0" Grid.Column="1"
                    Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center">
            <TextBlock Text="GPU" Width="32" FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <ProgressBar Value="{x:Bind GpuValue, Mode=OneWay}"
                         Minimum="0" Maximum="100"
                         MinWidth="80" Height="4"
                         CornerRadius="2"
                         Foreground="{StaticResource ContainerBadgeBrush}"
                         VerticalAlignment="Center"/>
            <TextBlock Text="{x:Bind GpuPercent, Mode=OneWay}"
                       Width="32" FontSize="11"
                       TextAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- NPU -->
        <StackPanel Grid.Row="1" Grid.Column="0"
                    Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center">
            <TextBlock Text="NPU" Width="32" FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <ProgressBar Value="{x:Bind NpuValue, Mode=OneWay}"
                         Minimum="0" Maximum="100"
                         MinWidth="80" Height="4"
                         CornerRadius="2"
                         Foreground="{StaticResource AccentTealBrush}"
                         VerticalAlignment="Center"/>
            <TextBlock Text="{x:Bind NpuPercent, Mode=OneWay}"
                       Width="32" FontSize="11"
                       TextAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- RAM -->
        <StackPanel Grid.Row="1" Grid.Column="1"
                    Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center">
            <TextBlock Text="RAM" Width="32" FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <ProgressBar Value="{x:Bind MemoryValue, Mode=OneWay}"
                         Minimum="0" Maximum="100"
                         MinWidth="80" Height="4"
                         CornerRadius="2"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         VerticalAlignment="Center"/>
            <TextBlock Text="{x:Bind MemoryPercent, Mode=OneWay}"
                       Width="32" FontSize="11"
                       TextAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

    </Grid>
</UserControl>
