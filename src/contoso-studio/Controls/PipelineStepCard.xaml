<UserControl
    x:Class="VideoStudio.Controls.PipelineStepCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VideoStudio.Controls"
    xmlns:models="using:VideoStudio.Models"
    xmlns:services="using:VideoStudio.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Border x:Name="CardBorder"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            CornerRadius="8"
            BorderThickness="1"
            Padding="0">

        <Border.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Run Step" Click="OnRunStepClick">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;"/></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Move Up" Click="OnMoveUpClick">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70E;"/></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Move Down" Click="OnMoveDownClick">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70D;"/></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Remove" Click="OnRemoveClick">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Border.ContextFlyout>

        <Grid>
            <!-- Left accent bar for state indication -->
            <Border x:Name="AccentBar"
                    HorizontalAlignment="Left"
                    Width="4"
                    CornerRadius="7,0,0,7"
                    Background="Transparent"/>

            <!-- Content — always visible, no Expander -->
            <StackPanel Margin="12,10,10,10" Spacing="8">

                <!-- Phase 8.8.5 — input pin chips (populated from code-behind) -->
                <StackPanel x:Name="PinChipsRow"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="Collapsed"/>

                <!-- Header row: icon, name, badge, spinner, duration, action buttons -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">
                    <FontIcon x:Name="StateIconElement"
                              Grid.Column="0"
                              FontSize="14"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Name="StepNameText"
                               Grid.Column="1"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="EngineBadgeText"
                               Grid.Column="2"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0"/>
                    <ProgressRing x:Name="RunningRing"
                                  Grid.Column="3"
                                  Width="16" Height="16"
                                  IsActive="True"
                                  Visibility="Collapsed"
                                  VerticalAlignment="Center"
                                  Margin="0,0,4,0"/>
                    <TextBlock x:Name="DurationTextBlock"
                               Grid.Column="4"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Button Grid.Column="5"
                            ToolTipService.ToolTip="Move Up"
                            Padding="5,3" Background="Transparent" BorderThickness="0"
                            Click="OnMoveUpClick">
                        <FontIcon Glyph="&#xE70E;" FontSize="11"/>
                    </Button>
                    <Button Grid.Column="6"
                            ToolTipService.ToolTip="Move Down"
                            Padding="5,3" Background="Transparent" BorderThickness="0"
                            Click="OnMoveDownClick">
                        <FontIcon Glyph="&#xE70D;" FontSize="11"/>
                    </Button>
                    <Button Grid.Column="7"
                            ToolTipService.ToolTip="Remove"
                            Padding="5,3" Background="Transparent" BorderThickness="0"
                            Click="OnRemoveClick">
                        <FontIcon Glyph="&#xE711;" FontSize="11"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    </Button>
                </Grid>

                <!-- Description -->
                <TextBlock x:Name="DescriptionText"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <!-- Result summary (visible after run) -->
                <TextBlock x:Name="ResultSummaryText"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{StaticResource AccentTealBrush}"
                           FontWeight="SemiBold"
                           FontSize="12"/>

                <!-- Device badge "Ran on NPU" — visible after a WinML run -->
                <Border x:Name="DeviceBadge"
                        Visibility="Collapsed"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{StaticResource AccentTealBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,2">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE9D9;" FontSize="11" Foreground="{StaticResource AccentTealBrush}"/>
                        <TextBlock x:Name="DeviceBadgeText" FontSize="11"
                                   Foreground="{StaticResource AccentTealBrush}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Bottom row: HW bars + Options + Run button -->
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <local:HardwareUsageBars x:Name="HwBars" Grid.Column="0"/>
                    <Button x:Name="OptionsButton"
                            Grid.Column="1"
                            Padding="8,6" CornerRadius="4"
                            Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            ToolTipService.ToolTip="Options"
                            Visibility="Collapsed">
                        <FontIcon Glyph="&#xE713;" FontSize="12"/>
                        <Button.Flyout>
                            <Flyout x:Name="OptionsFlyout">
                                <StackPanel Spacing="14" Width="280">
                                    <TextBlock Text="Options" FontWeight="SemiBold"/>
                                    <StackPanel x:Name="OptionsConfidencePanel" Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Confidence threshold" FontSize="12"/>
                                            <TextBlock Grid.Column="1" x:Name="OptionsConfidenceValueText"
                                                       FontSize="12" FontFamily="Consolas"
                                                       Foreground="{StaticResource AccentTealBrush}"/>
                                        </Grid>
                                        <Slider x:Name="OptionsConfidenceSlider"
                                                Minimum="5" Maximum="95"
                                                StepFrequency="5" TickFrequency="10"
                                                ValueChanged="OnOptionsConfidenceChanged"/>
                                        <TextBlock Text="Higher = fewer, more certain detections."
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel x:Name="OptionsFramesPanel" Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Frames to sample" FontSize="12"/>
                                            <TextBlock Grid.Column="1" x:Name="OptionsFramesValueText"
                                                       FontSize="12" FontFamily="Consolas"
                                                       Foreground="{StaticResource AccentTealBrush}"/>
                                        </Grid>
                                        <Slider x:Name="OptionsFramesSlider"
                                                Minimum="15" Maximum="180"
                                                StepFrequency="15" TickFrequency="30"
                                                ValueChanged="OnOptionsFramesChanged"/>
                                        <TextBlock Text="More frames = smoother output, longer runtime."
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Whisper-specific options -->
                                    <StackPanel x:Name="OptionsWhisperPanel" Spacing="10" Visibility="Collapsed">
                                        <ComboBox x:Name="OptionsWhisperModelCombo"
                                                  Header="Model size"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnOptionsWhisperModelChanged">
                                            <x:String>Tiny  (77 MB, fastest)</x:String>
                                            <x:String>Small  (440 MB)</x:String>
                                            <x:String>Medium  (1.4 GB, slowest)</x:String>
                                        </ComboBox>
                                        <ComboBox x:Name="OptionsWhisperLanguageCombo"
                                                  Header="Language"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnOptionsWhisperLanguageChanged"/>
                                        <ToggleSwitch x:Name="OptionsWhisperTranslateToggle"
                                                      Header="Translate to English"
                                                      OffContent="Off" OnContent="On"
                                                      Toggled="OnOptionsWhisperTranslateToggled"/>
                                    </StackPanel>

                                    <!-- Hardware preference (shown for WinML steps) -->
                                    <StackPanel x:Name="OptionsHardwarePanel" Spacing="4" Visibility="Collapsed">
                                        <ComboBox x:Name="OptionsHardwareCombo"
                                                  Header="Hardware"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnOptionsHardwareChanged">
                                            <x:String>Auto (best available)</x:String>
                                            <x:String>NPU</x:String>
                                            <x:String>GPU</x:String>
                                            <x:String>CPU</x:String>
                                        </ComboBox>
                                        <TextBlock Text="Auto picks the fastest device. Falls back to CPU if unavailable."
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Detect Silence options -->
                                    <StackPanel x:Name="OptionsSilencePanel" Spacing="10" Visibility="Collapsed">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Threshold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" x:Name="OptionsSilenceThreshValueText" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                            <Slider x:Name="OptionsSilenceThreshSlider"
                                                    Minimum="-60" Maximum="-20" StepFrequency="1" SmallChange="1" LargeChange="5"
                                                    Width="220"
                                                    ValueChanged="OnOptionsSilenceThreshChanged"/>
                                            <TextBlock Text="Lower = stricter (only quieter audio counts as silent)."
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Min silence" FontSize="12"/>
                                                <TextBlock Grid.Column="1" x:Name="OptionsSilenceMinValueText" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                            <Slider x:Name="OptionsSilenceMinSlider"
                                                    Minimum="100" Maximum="3000" StepFrequency="50" SmallChange="50" LargeChange="250"
                                                    Width="220"
                                                    ValueChanged="OnOptionsSilenceMinChanged"/>
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Padding" FontSize="12"/>
                                                <TextBlock Grid.Column="1" x:Name="OptionsSilencePadValueText" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                            <Slider x:Name="OptionsSilencePadSlider"
                                                    Minimum="0" Maximum="1000" StepFrequency="50" SmallChange="50" LargeChange="100"
                                                    Width="220"
                                                    ValueChanged="OnOptionsSilencePadChanged"/>
                                            <TextBlock Text="Inset from speech onset/offset, so cuts don't clip words."
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Smart Cut options -->
                                    <StackPanel x:Name="OptionsSmartCutPanel" Spacing="10" Visibility="Collapsed">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Min keep duration" FontSize="12"/>
                                                <TextBlock Grid.Column="1" x:Name="OptionsMinKeepValueText" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                            <Slider x:Name="OptionsMinKeepSlider"
                                                    Minimum="0" Maximum="2000" StepFrequency="50" SmallChange="50" LargeChange="200"
                                                    Width="220"
                                                    ValueChanged="OnOptionsMinKeepChanged"/>
                                            <TextBlock Text="Drop kept segments shorter than this — avoids choppy micro-cuts."
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Language model backend (Chapter Markers / Show Notes / Highlights) -->
                                    <StackPanel x:Name="OptionsLanguageModelPanel" Spacing="4" Visibility="Collapsed">
                                        <TextBlock Text="Language model" FontSize="12"/>
                                        <ComboBox x:Name="OptionsLanguageModelCombo"
                                                  Width="240"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectionChanged="OnOptionsLanguageModelChanged"/>
                                        <TextBlock x:Name="OptionsLanguageModelTagline"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <!-- Chapter Markers options -->
                                    <StackPanel x:Name="OptionsChaptersPanel" Spacing="10" Visibility="Collapsed">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Target chapter count" FontSize="12"/>
                                                <TextBlock Grid.Column="1" x:Name="OptionsChapterCountValueText" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                            <Slider x:Name="OptionsChapterCountSlider"
                                                    Minimum="2" Maximum="20" StepFrequency="1" SmallChange="1" LargeChange="2"
                                                    Width="220"
                                                    ValueChanged="OnOptionsChapterCountChanged"/>
                                            <TextBlock Text="Phi Silica picks chapter boundaries from the upstream transcript."
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Highlight Picker options -->
                                    <StackPanel x:Name="OptionsHighlightsPanel" Spacing="10" Visibility="Collapsed">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Number of highlights" FontSize="12"/>
                                                <TextBlock Grid.Column="1" x:Name="OptionsHighlightCountValueText" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                            <Slider x:Name="OptionsHighlightCountSlider"
                                                    Minimum="1" Maximum="10" StepFrequency="1" SmallChange="1" LargeChange="1"
                                                    Width="220"
                                                    ValueChanged="OnOptionsHighlightCountChanged"/>
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Clip length (seconds)" FontSize="12"/>
                                                <TextBlock Grid.Column="1" x:Name="OptionsHighlightClipSecValueText" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                            <Slider x:Name="OptionsHighlightClipSecSlider"
                                                    Minimum="10" Maximum="120" StepFrequency="5" SmallChange="5" LargeChange="10"
                                                    Width="220"
                                                    ValueChanged="OnOptionsHighlightClipSecChanged"/>
                                            <TextBlock Text="Phi Silica scores transcript regions for share-worthiness."
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Grid.Column="2"
                            Padding="10,6" CornerRadius="4"
                            Click="OnRunStepClick"
                            Background="{StaticResource AccentTealBrush}"
                            Foreground="White" BorderThickness="0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="12"/>
                            <TextBlock Text="Run Step" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Inline artifacts panel: Expander wraps a row of ToggleButton tabs + content panes -->
                <Expander x:Name="ArtifactsExpander"
                          Header="Artifacts"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <!-- Tab strip: plain ToggleButtons. Reliable mouse hit-testing. -->
                        <StackPanel x:Name="TabStrip" Orientation="Horizontal" Spacing="4">
                            <ToggleButton x:Name="TabPreview" Click="OnTabClick"
                                          Padding="12,6" MinWidth="0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE714;" FontSize="12"/>
                                    <TextBlock Text="Preview" FontSize="12"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="TabDetections" Click="OnTabClick"
                                          Padding="12,6" MinWidth="0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8EC;" FontSize="12"/>
                                    <TextBlock x:Name="TabDetectionsText" Text="Detections" FontSize="12"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="TabTranscript" Click="OnTabClick"
                                          Padding="12,6" MinWidth="0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8D4;" FontSize="12"/>
                                    <TextBlock x:Name="TabTranscriptText" Text="Transcript" FontSize="12"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="TabSilence" Click="OnTabClick"
                                          Padding="12,6" MinWidth="0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74F;" FontSize="12"/>
                                    <TextBlock x:Name="TabSilenceText" Text="Silence" FontSize="12"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="TabChapters" Click="OnTabClick"
                                          Padding="12,6" MinWidth="0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="12"/>
                                    <TextBlock x:Name="TabChaptersText" Text="Chapters" FontSize="12"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="TabNotes" Click="OnTabClick"
                                          Padding="12,6" MinWidth="0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="12"/>
                                    <TextBlock x:Name="TabNotesText" Text="Notes" FontSize="12"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="TabHighlights" Click="OnTabClick"
                                          Padding="12,6" MinWidth="0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE734;" FontSize="12"/>
                                    <TextBlock x:Name="TabHighlightsText" Text="Highlights" FontSize="12"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="TabClips" Click="OnTabClick"
                                          Padding="12,6" MinWidth="0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74B;" FontSize="12"/>
                                    <TextBlock x:Name="TabClipsText" Text="Clips" FontSize="12"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="TabLogs" Click="OnTabClick"
                                          Padding="12,6" MinWidth="0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="12"/>
                                    <TextBlock Text="Logs" FontSize="12"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="TabFiles" Click="OnTabClick"
                                          Padding="12,6" MinWidth="0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="12"/>
                                    <TextBlock Text="Files" FontSize="12"/>
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>

                    <!-- Preview tab — thumbnail + Play button. Opens video in OS default player. -->
                    <Grid x:Name="PreviewPane" Visibility="Collapsed">
                        <Border x:Name="PreviewThumbBorder"
                                Height="220"
                                CornerRadius="4"
                                Background="{ThemeResource ControlFillColorTertiaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Image x:Name="PreviewThumbImage"
                                       Stretch="Uniform"/>
                                <Button x:Name="PreviewPlayButton"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Click="OnPreviewPlayClick"
                                        Padding="14,10"
                                        CornerRadius="24"
                                        Background="{StaticResource AccentTealBrush}"
                                        Foreground="White"
                                        BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                        <TextBlock Text="Play in default app" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="PreviewEmptyText"
                                           Text="No preview available — run this step to generate output."
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Detections tab -->
                    <Grid x:Name="DetectionsPane" Visibility="Collapsed">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="DetectionsSummary"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ListView x:Name="DetectionsList"
                                      MaxHeight="240"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:DetectionViewItem">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Padding="0,2">
                                            <Border Grid.Column="0"
                                                    Width="6"
                                                    Background="{x:Bind LabelColorBrush}"
                                                    CornerRadius="3"
                                                    Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind FrameText}"
                                                       FontFamily="Consolas" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Margin="0,0,12,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind Label}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{x:Bind ConfidenceText}"
                                                       FontFamily="Consolas" FontSize="11"
                                                       Foreground="{StaticResource AccentTealBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="DetectionsEmptyText"
                                       Text="No detections yet."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- Logs tab -->
                    <Grid x:Name="LogsPane" Visibility="Collapsed">
                        <ScrollViewer x:Name="LogScrollViewer" MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogText"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- Transcript tab -->
                    <Grid x:Name="TranscriptPane" Visibility="Collapsed">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="TranscriptSummary"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ScrollViewer x:Name="TranscriptScrollViewer" MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                <ItemsRepeater x:Name="TranscriptList">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:TranscriptSegment">
                                            <Grid ColumnDefinitions="80,*" Margin="0,2">
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind models:TranscriptSegment.FormatTime(Start)}"
                                                           FontFamily="Consolas" FontSize="11"
                                                           Foreground="{StaticResource AccentTealBrush}"
                                                           VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Text}"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"
                                                           IsTextSelectionEnabled="True"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                            <TextBlock x:Name="TranscriptEmptyText"
                                       Text="No transcript yet. Run this step to generate one."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- Silence tab -->
                    <Grid x:Name="SilencePane" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="SilenceSummary"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <!-- Mini-timeline: silent regions painted as red rectangles over the audio length -->
                            <Border Height="28"
                                    CornerRadius="4"
                                    Background="{ThemeResource ControlFillColorTertiaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Canvas x:Name="SilenceTimelineCanvas"
                                        SizeChanged="OnSilenceTimelineSizeChanged"/>
                            </Border>
                            <ScrollViewer x:Name="SilenceScrollViewer" MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                <ItemsRepeater x:Name="SilenceList">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:SilenceInterval">
                                            <Grid ColumnDefinitions="90,90,*" Margin="0,2">
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind models:SilenceInterval.FormatTime(Start)}"
                                                           FontFamily="Consolas" FontSize="11"
                                                           Foreground="{StaticResource AccentTealBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind models:SilenceInterval.FormatTime(End)}"
                                                           FontFamily="Consolas" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind models:SilenceInterval.FormatDuration(Duration)}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                            <TextBlock x:Name="SilenceEmptyText"
                                       Text="No silence detected. Try lowering the threshold or min duration."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- Chapters tab -->
                    <Grid x:Name="ChaptersPane" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ChaptersSummary"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ScrollViewer x:Name="ChaptersScrollViewer" MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsRepeater x:Name="ChaptersList">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:Chapter">
                                            <Border Padding="8,6" Margin="0,2"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                <Grid ColumnDefinitions="80,*">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{x:Bind models:Chapter.FormatTime(Start)}"
                                                               FontFamily="Consolas" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentTealBrush}"
                                                               VerticalAlignment="Top"/>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{x:Bind Title}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   IsTextSelectionEnabled="True"/>
                                                        <TextBlock Text="{x:Bind Summary}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   IsTextSelectionEnabled="True"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                            <TextBlock x:Name="ChaptersEmptyText"
                                       Text="No chapters yet. Run this step to generate them."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- Notes tab — markdown rendered as styled blocks. -->
                    <Grid x:Name="NotesPane" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="NotesSummary"
                                           Grid.Column="0"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Button x:Name="CopyNotesButton"
                                        Grid.Column="1"
                                        Click="OnCopyNotesClick"
                                        Padding="8,4" FontSize="11">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                                        <TextBlock Text="Copy markdown"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ScrollViewer x:Name="NotesScrollViewer" MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="NotesContent" Spacing="6"/>
                            </ScrollViewer>
                            <TextBlock x:Name="NotesEmptyText"
                                       Text="No notes yet. Run this step to generate them."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- Highlights tab — top N share-worthy clips. -->
                    <Grid x:Name="HighlightsPane" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="HighlightsSummary"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ScrollViewer x:Name="HighlightsScrollViewer" MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsRepeater x:Name="HighlightsList">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:Highlight">
                                            <Border Padding="10,8" Margin="0,3"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Border Grid.Column="0"
                                                            Padding="8,4"
                                                            Margin="0,0,12,0"
                                                            CornerRadius="3"
                                                            VerticalAlignment="Top"
                                                            Background="{StaticResource AccentTealBrush}">
                                                        <TextBlock Text="{x:Bind models:Highlight.FormatRange(Start, End)}"
                                                                   FontFamily="Consolas" FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Text="{x:Bind Title}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   IsTextSelectionEnabled="True"/>
                                                        <TextBlock Text="{x:Bind Reason}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   IsTextSelectionEnabled="True"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                            <TextBlock x:Name="HighlightsEmptyText"
                                       Text="No highlights yet. Run this step to generate them."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- Clips tab — exported short clip files. -->
                    <Grid x:Name="ClipsPane" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ClipsSummary"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ScrollViewer x:Name="ClipsScrollViewer" MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsRepeater x:Name="ClipsList">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="services:ExportedClip">
                                            <Border Padding="10,8" Margin="0,3"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                                    <Border Grid.Column="0"
                                                            Padding="8,4"
                                                            CornerRadius="3"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource AccentTealBrush}">
                                                        <TextBlock Text="{x:Bind TimeRangeText}"
                                                                   FontFamily="Consolas" FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Title}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   IsTextSelectionEnabled="True"/>
                                                        <TextBlock Text="{x:Bind FileName}"
                                                                   FontFamily="Consolas" FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{x:Bind FileSizeText}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <Button Grid.Column="3"
                                                            Tag="{x:Bind OutputPath}"
                                                            Click="OnOpenClipClick"
                                                            Padding="8,4" FontSize="11"
                                                            Content="Open"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                            <Button x:Name="OpenClipsFolderButton"
                                    Click="OnOpenClipsFolderClick"
                                    Padding="8,4" FontSize="11"
                                    HorizontalAlignment="Left"
                                    Content="Show clips folder"/>
                            <TextBlock x:Name="ClipsEmptyText"
                                       Text="No clips yet. Add a Highlight Picker step before this one and Run All."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- Files tab -->
                    <Grid x:Name="FilesPane" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Input" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="InputPathText"
                                               Grid.Column="0"
                                               FontFamily="Consolas" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               IsTextSelectionEnabled="True"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="OpenInputFolderButton"
                                            Grid.Column="1"
                                            Click="OnOpenInputFolderClick"
                                            Padding="8,4" FontSize="11"
                                            Content="Show in Explorer"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Output" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="OutputPathText"
                                               Grid.Column="0"
                                               FontFamily="Consolas" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               IsTextSelectionEnabled="True"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="OpenOutputFolderButton"
                                            Grid.Column="1"
                                            Click="OnOpenOutputFolderClick"
                                            Padding="8,4" FontSize="11"
                                            Content="Show in Explorer"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
