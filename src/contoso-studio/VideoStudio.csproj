<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>VideoStudio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <NoWarn>NU1701</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\Models\yolos-small.onnx" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\Models\yolos-small.onnx')" />
    <Content Include="Assets\Models\imagenet1k-labels.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- CLIP (openai/clip-vit-base-patch16) — NPU-compiled via the winml CLI.
         The .onnx is a tiny EPContext wrapper that points at the co-located compiled_qnn.bin,
         so both files must travel together. Plus the BPE tokenizer assets. -->
    <Content Include="Assets\Models\clip-vit-base-patch16\image-encoder\model.onnx" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\Models\clip-vit-base-patch16\image-encoder\model.onnx')" />
    <Content Include="Assets\Models\clip-vit-base-patch16\image-encoder\compiled_qnn.bin" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\Models\clip-vit-base-patch16\image-encoder\compiled_qnn.bin')" />
    <Content Include="Assets\Models\clip-vit-base-patch16\text-encoder\model.onnx" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\Models\clip-vit-base-patch16\text-encoder\model.onnx')" />
    <Content Include="Assets\Models\clip-vit-base-patch16\text-encoder\compiled_qnn.bin" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\Models\clip-vit-base-patch16\text-encoder\compiled_qnn.bin')" />
    <!-- CLIP OpenVINO build (Intel NPU / Core Ultra) — same shape, EPContext wrapper + co-located .bin. -->
    <Content Include="Assets\Models\clip-vit-base-patch16\image-encoder-openvino\model.onnx" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\Models\clip-vit-base-patch16\image-encoder-openvino\model.onnx')" />
    <Content Include="Assets\Models\clip-vit-base-patch16\image-encoder-openvino\compiled_OpenVINOExecutionProvider.bin" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\Models\clip-vit-base-patch16\image-encoder-openvino\compiled_OpenVINOExecutionProvider.bin')" />
    <Content Include="Assets\Models\clip-vit-base-patch16\text-encoder-openvino\model.onnx" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\Models\clip-vit-base-patch16\text-encoder-openvino\model.onnx')" />
    <Content Include="Assets\Models\clip-vit-base-patch16\text-encoder-openvino\compiled_OpenVINOExecutionProvider.bin" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\Models\clip-vit-base-patch16\text-encoder-openvino\compiled_OpenVINOExecutionProvider.bin')" />
    <Content Include="Assets\Models\clip-vit-base-patch16\tokenizer\vocab.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\Models\clip-vit-base-patch16\tokenizer\vocab.json')" />
    <Content Include="Assets\Models\clip-vit-base-patch16\tokenizer\merges.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\Models\clip-vit-base-patch16\tokenizer\merges.txt')" />
    <Content Include="Assets\Notebooks\*.studionb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="tools\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" Link="tools\ffmpeg.exe" Condition="Exists('tools\ffmpeg.exe')" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.AI.Foundry.Local.WinML" Version="1.2.0" />
    <!-- Foundry transitively pulls these cross-platform ORT packages. We only ship Windows,
         so suppress them — they cause MSBuild copy failures on win-arm64 (missing .dll
         in the package payload). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" Version="1.26.0" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Foundry" Version="1.26.0" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Extensions" Version="0.14.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.3.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenAI" Version="2.10.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.8" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>
  <!-- Foundry Local ships its own onnxruntime.dll which collides with WindowsML's.
       Foundry runs its inference engine out-of-process via the bundled service binary,
       so its in-package native ORT is not actually needed for our usage (we talk to it
       over HTTP). Strip the duplicate from the MSIX payload. -->
  <Target Name="DedupeFoundryOnnxRuntime" AfterTargets="ResolveAssemblyReferences" BeforeTargets="_GenerateAppxPackage;GenerateAppxPackage;_CopyFilesMarkedCopyLocal">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(FileName)%(Extension)' == 'onnxruntime.dll' and $([System.String]::Copy('%(FullPath)').Contains('microsoft.ml.onnxruntime.foundry'))" />
      <None Remove="@(None)" Condition="'%(FileName)%(Extension)' == 'onnxruntime.dll' and $([System.String]::Copy('%(FullPath)').Contains('microsoft.ml.onnxruntime.foundry'))" />
      <Content Remove="@(Content)" Condition="'%(FileName)%(Extension)' == 'onnxruntime.dll' and $([System.String]::Copy('%(FullPath)').Contains('microsoft.ml.onnxruntime.foundry'))" />
    </ItemGroup>
  </Target>

</Project>